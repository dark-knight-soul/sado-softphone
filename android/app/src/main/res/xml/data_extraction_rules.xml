<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 и новее: историю звонков, контакты и зашифрованный пароль не копируем ни в облако,
     ни при переносе на другой телефон (пароль там всё равно не расшифруется: ключ не покидает устройство). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
