.env
*.local
*.jks
*.keystore
key.properties
google-services.json

# Реестр аудита безопасности — в публичный репозиторий не попадает (это карта слабых мест).
.security-audit/

# Личные заметки и настройки рабочего места — не для репозитория.
ДОСТУПЫ.md
*.cmd
.claude/

# Временная подстановка зависимостей (tool/stand_check/run.py)
pubspec_overrides.yaml
